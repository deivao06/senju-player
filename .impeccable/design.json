  "narrative": {
    "northStar": "Cinema em casa",
    "overview": "Painel audiovisual doméstico: preto esverdeado, controles precisos e conteúdo em primeiro plano. A linguagem dos equipamentos de sala inspira separação tonal, espaçamento consistente e foco nítido.\n\nSistema nativo React Native TV, com tipografia do sistema e ícones locais; não exige novas fontes, imagens decorativas ou dependências. A documentação descreve o código atual, sem afirmar aprovação visual ou desempenho em hardware.",
    "keyCharacteristics": [
      "Identidade verde escura com acento luminoso reservado às ações.",
      "Contorno claro e preenchimento distinguem foco de seleção.",
      "Profundidade tonal, sem sombras decorativas ou blur."
    ],
    "rules": [
      {
        "name": "The Focus Rule",
        "body": "Foco deve combinar contorno claro e mudança de preenchimento; seleção permanece mais contida.",
        "section": "colors"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Usar superfícies e contornos para hierarquia, sem blur ou brilho decorativo.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preservar o foco por contorno e preenchimento em controles e campos.",
      "Do usar tipografia nativa e números tabulares nos tempos.",
      "Do manter informação contextual em espaço reservado, sem deslocar a grade."
    ],
    "donts": [
      "Don't saturar todas as superfícies com verde de ação.",
      "Don't adicionar blur, brilho decorativo ou animação contínua.",
      "Don't tratar exemplos HTML do sidecar como validação do aplicativo nativo."
    ]
  }
