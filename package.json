{
  "name": "senju-player",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "pnpm --filter @senju/web dev",
    "build": "pnpm --filter @senju/web build",
    "lint": "pnpm --filter @senju/web lint",
    "test": "pnpm --filter @senju/iptv test && pnpm --filter @senju/fire-tv test && pnpm --filter @senju/smart-tv test",
    "tv:start": "pnpm --filter @senju/fire-tv start",
    "tv:android": "pnpm --filter @senju/fire-tv android",
    "tv:typecheck": "pnpm --filter @senju/fire-tv typecheck",
    "tv:apk:debug": "pnpm --filter @senju/fire-tv apk:debug",
    "tv:apk:release": "pnpm --filter @senju/fire-tv apk:release",
    "preview": "pnpm --filter @senju/web preview",
    "tv:apk:sideload": "pnpm --filter @senju/fire-tv apk:sideload",
    "smart:dev": "pnpm --filter @senju/smart-tv dev",
    "smart:build": "pnpm --filter @senju/smart-tv build",
    "smart:test": "pnpm --filter @senju/smart-tv test",
    "smart:build:webos": "pnpm --filter @senju/smart-tv build:webos",
    "smart:build:tizen": "pnpm --filter @senju/smart-tv build:tizen"
  },
  "pnpm": {
    "overrides": {
      "mpegts.js>webworkify-webpack": "https://codeload.github.com/xqq/webworkify-webpack/tar.gz/24d1e719b4a6cac37a518b2bb10fe124527ef4ef"
    }
  }
}
